<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the in-app look; this base theme just sets a calm splash background
         and lets the activity start edge-to-edge without a Material action bar. -->
    <style name="Theme.LorFocus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
